# Course-specific settings for scripts/course.sh (sourced as bash; generated by copier --
# change them with `copier update` / by re-answering, or edit here and commit).

# Slides downloaded into course/slides/ are named "<SLIDE_PREFIX> NN.pdf"; the annotated
# version has ANNOTATED_MARKER somewhere in its name (e.g. "Lecture 06 - post.pdf").
SLIDE_PREFIX="[[ slide_prefix ]]"
ANNOTATED_MARKER="[[ annotated_marker ]]"

# Name for the official assignment PDF in homework/hwN/handout/ ({N} = homework number).
HW_PDF_PATTERN="[[ hw_pdf_pattern ]]"
